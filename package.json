{
  "name": "neurosyncpro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp main.html sw.js dist/",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit && echo 'Type checking passed!'",
    "validate:protocols": "tsx scripts/check-protocols.ts"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@fontsource/material-symbols-outlined": "^5.0.0",
    "@fontsource/michroma": "^5.0.0",
    "@fontsource/outfit": "^5.0.0",
    "@fontsource/share-tech-mono": "^5.0.0",
    "@fontsource/space-grotesk": "^5.0.0",
    "@fontsource/space-mono": "^5.0.0",
    "@fontsource/teko": "^5.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.1.5",
